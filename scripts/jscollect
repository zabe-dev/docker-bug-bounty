#!/usr/bin/env bash
# jscollect - collect JS file URLs for an in-scope bug bounty target
#
# Usage:   ./jscollect target.com [rate_limit] [-o output]
# Output:  js.txt  (unique, live (HTTP 200) JS URLs)
#
# Requires: subfinder, httpx (ProjectDiscovery), katana, gau, waybackurls
# Only run this against targets that are in scope for the program.

set -uo pipefail

# The Python package also installs a command named httpx. Always use the
# ProjectDiscovery binary shipped by the container instead of relying on PATH.
HTTPX_BIN="/home/bug-bounty/.pdtm/go/bin/httpx"

usage() {
  cat <<'EOF'
Usage: jscollect target.com [rate_limit] [-o output]

Collect unique JavaScript URLs for a target, retain only HTTP 200 files,
and write them to js.txt in the current directory (or /mnt/output/js.txt
when run inside the project container).

Arguments:
  target.com   In-scope bug bounty domain to scan
  rate_limit   Requests per second for active tools (default: 50)
  -o, --output Output file (default: /mnt/output/js.txt in the container)

Requires: subfinder, ProjectDiscovery httpx, katana, gau, waybackurls
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

DOMAIN="${1:-}"
if [[ -z "$DOMAIN" || "$DOMAIN" == -* ]]; then
  usage >&2
  exit 1
fi
shift

RATE="50"   # requests per second cap for active tools
RATE_SET=0
if [[ -d /mnt/output ]]; then
  OUT="/mnt/output/js.txt"
else
  OUT="js.txt"
fi

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -o|--output)
      if [[ "$#" -lt 2 || -z "$2" ]]; then
        echo "[!] $1 requires an output path." >&2
        exit 1
      fi
      OUT="$2"
      shift 2
      ;;
    --)
      shift
      if [[ "$#" -gt 0 ]]; then
        echo "[!] Unexpected argument: $1" >&2
        exit 1
      fi
      ;;
    -* )
      echo "[!] Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ "$RATE_SET" -eq 1 ]]; then
        echo "[!] Unexpected argument: $1" >&2
        exit 1
      fi
      RATE="$1"
      RATE_SET=1
      shift
      ;;
  esac
done

if ! [[ "$RATE" =~ ^[0-9]+$ ]] || (( RATE < 1 )); then
  echo "[!] rate_limit must be a positive integer." >&2
  exit 1
fi

mkdir -p "$(dirname "$OUT")"

TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

log() {
  printf '[jscollect] %s\n' "$*" >&2
}

# --- dependency check ---
MISSING=0
for tool in subfinder katana gau waybackurls; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "[!] Missing tool: $tool" >&2
    MISSING=1
  fi
done
if [[ ! -x "$HTTPX_BIN" ]]; then
  echo "[!] Missing ProjectDiscovery httpx: $HTTPX_BIN" >&2
  MISSING=1
fi
if [[ $MISSING -eq 1 ]]; then
  echo "[!] Install the missing tools and re-run." >&2
  echo "    Note: 'httpx' must be the ProjectDiscovery one, not the Python package." >&2
  exit 1
fi

JS_REGEX='\.js(\?[^ ]*)?$'

SUBDOMAINS="$TMPDIR/subdomains.txt"
HOSTS="$TMPDIR/hosts.txt"
KATANA_URLS="$TMPDIR/katana-urls.txt"
GAU_URLS="$TMPDIR/gau-urls.txt"
WAYBACK_URLS="$TMPDIR/waybackurls.txt"

log "subfinder: discovering subdomains for $DOMAIN"
if ! subfinder -d "$DOMAIN" -silent \
  2> >(sed 's/^/[subfinder] /' >&2) \
  | sort -u > "$SUBDOMAINS"; then
  log "subfinder: failed"
  exit 1
fi
printf '%s\n' "$DOMAIN" >> "$SUBDOMAINS"
sed -E 's#^https?://##; s#/$##' "$SUBDOMAINS" | sort -u > "$HOSTS"
awk '{ print "https://" $0; print "http://" $0 }' "$HOSTS" > "$HOSTS.urls"
log "subfinder: $(wc -l < "$HOSTS" | tr -d ' ') unique subdomains, including root domain"

log "katana: crawling every discovered target (depth 3, JavaScript crawling enabled)"
if ! katana -list "$HOSTS.urls" -jc -d 3 -silent -rl "$RATE" \
  2> >(sed 's/^/[katana] /' >&2) > "$KATANA_URLS"; then
  log "katana: failed"
  exit 1
fi
log "katana: $(wc -l < "$KATANA_URLS" | tr -d ' ') URLs collected"

log "gau: collecting historical URLs for subdomains"
if ! gau --subs "$DOMAIN" \
  2> >(sed 's/^/[gau] /' >&2) > "$GAU_URLS"; then
  log "gau: failed"
  exit 1
fi
log "gau: $(wc -l < "$GAU_URLS" | tr -d ' ') URLs collected"

log "waybackurls: collecting Wayback Machine URLs for subdomains"
if ! waybackurls < "$HOSTS" \
  2> >(sed 's/^/[waybackurls] /' >&2) > "$WAYBACK_URLS"; then
  log "waybackurls: failed"
  exit 1
fi
log "waybackurls: $(wc -l < "$WAYBACK_URLS" | tr -d ' ') URLs collected"

log "httpx: checking JavaScript URLs for HTTP 200 responses"
cat "$KATANA_URLS" "$GAU_URLS" "$WAYBACK_URLS" \
  | grep -Ei "$JS_REGEX" | sort -u \
  | "$HTTPX_BIN" -silent -mc 200 -rl "$RATE" \
      2> >(sed 's/^/[httpx] /' >&2) \
  | sort -u > "$OUT"
log "httpx: $(wc -l < "$OUT" | tr -d ' ') live JavaScript URLs written to $OUT"
